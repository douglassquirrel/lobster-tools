#!/usr/bin/env python3
"""fetch-deb: a program from Debian packages, unpacked into a folder without root, behind a
wrapper, and the export line naming it. Run with --help."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from lobstertools.fetchdeb import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
