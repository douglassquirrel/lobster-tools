#!/usr/bin/env python3
"""wait-for-file: wait until a file appears and, if asked, has stopped changing. Run with --help."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from lobstertools.waitfile import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
