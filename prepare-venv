#!/usr/bin/env python3
"""prepare-venv: a project's venv for the Linux device shell, its packages, its model check, one
setting in its config and the export lines. Run with --help."""
import os
import sys

# Standard library only, on whatever python3 runs it: this command makes the venv a project's
# commands run under, so it cannot use that venv.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from lobstertools.prepare import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
