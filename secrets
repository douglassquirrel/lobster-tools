#!/usr/bin/env python3
"""secrets: keep named sets of secrets and run a command with them, never printing a value. Run
with --help."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from lobstertools.secrets import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
