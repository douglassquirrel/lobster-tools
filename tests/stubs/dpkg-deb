#!/bin/sh
# Stand-in for dpkg-deb in fetch-deb's tests (tests/tier2/test_fetch_deb.py). Linked onto a test's
# PATH; never written by a test. Each call is appended to $DEBSTUB_DIR/calls as apt-get's are.
#   dpkg-fails      say so on stderr and exit 2
# `-x FILE DIR` reads the package's name from FILE and makes in DIR each path listed, one a line,
# in $DEBSTUB_DIR/contents/NAME: a path with /bin/ in it as a program that prints
# LD=$LD_LIBRARY_PATH and its arguments, one a line; any other as an empty file.
d=$DEBSTUB_DIR
printf '%s\0' "$0" "$@" "--end--" >> "$d/calls"
if [ -f "$d/dpkg-fails" ]; then echo "dpkg-deb: error: stand-in failure" >&2; exit 2; fi
if [ "$1" != "-x" ]; then echo "stand-in dpkg-deb: not expected: $*" >&2; exit 2; fi
pkg=$(cat "$2")
dest=$3
mkdir -p "$dest"
if [ ! -f "$d/contents/$pkg" ]; then exit 0; fi
while IFS= read -r path; do
    mkdir -p "$dest/$(dirname "$path")"
    case "$path" in
        */bin/*)
            printf '#!/bin/sh\nprintf "%%s\\n" "LD=$LD_LIBRARY_PATH" "$@"\n' > "$dest/$path"
            chmod 755 "$dest/$path";;
        *) : > "$dest/$path";;
    esac
done < "$d/contents/$pkg"
