#!/bin/sh
# Stand-in for a command run by `secrets run` in its tests (tests/tier2/test_secrets_run.py). Run
# by its full path; never written by a test.
#   secretstub env NAME ...    print NAME=value, or NAME unset, for each
#   secretstub args ARG ...    print each ARG followed by a NUL
#   secretstub leak NAME       print NAME's value on stdout, and "err:" and it on stderr
#   secretstub exit CODE       exit with CODE
#   secretstub term            end itself with SIGTERM
what=$1
shift
case $what in
env)
    for name in "$@"; do
        if eval "[ \"\${$name+x}\" = x ]"; then eval "printf '%s=%s\n' \"$name\" \"\$$name\""
        else printf '%s unset\n' "$name"; fi
    done ;;
args) for arg in "$@"; do printf '%s\0' "$arg"; done ;;
leak) eval "printf 'out:%s\n' \"\$$1\"; printf 'err:%s\n' \"\$$1\" >&2" ;;
exit) exit "$1" ;;
term) kill -TERM $$ ;;
esac
