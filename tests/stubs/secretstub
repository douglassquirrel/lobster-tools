#!/bin/sh
# Stand-in for a command run by `secrets run` in its tests (tests/tier2/test_secrets_run.py). Run
# by its full path; never written by a test.
#   secretstub env NAME ...    print NAME=value, or NAME unset, for each
#   secretstub args ARG ...    print each ARG followed by a NUL
#   secretstub leak NAME       print NAME's value on stdout, and "err:" and it on stderr
#   secretstub exit CODE       exit with CODE
#   secretstub term            end itself with SIGTERM
#   secretstub wait DIR NAME   log each SIGTERM, SIGINT or SIGHUP it gets to DIR/got, one a line; once
#                              one has come (or DIR/go appears), print "out:" and NAME's value and end
#                              128+N (or 0). With DIR/ignore-term, it ignores SIGTERM. Writes its pid
#                              to DIR/pid once its traps are set. Gives up after about 10 seconds.
what=$1
shift
case $what in
env)
    for name in "$@"; do
        if eval "[ \"\${$name+x}\" = x ]"; then eval "printf '%s=%s\n' \"$name\" \"\$$name\""
        else printf '%s unset\n' "$name"; fi
    done ;;
args) for arg in "$@"; do printf '%s\0' "$arg"; done ;;
leak) eval "printf 'out:%s\n' \"\$$1\"; printf 'err:%s\n' \"\$$1\" >&2" ;;
exit) exit "$1" ;;
term) kill -TERM $$ ;;
wait)
    end=
    trap 'echo TERM >> "$1/got"; end=143' TERM
    trap 'echo INT >> "$1/got"; end=130' INT
    trap 'echo HUP >> "$1/got"; end=129' HUP
    if [ -e "$1/ignore-term" ]; then trap '' TERM; fi
    echo $$ > "$1/pid.new" && mv "$1/pid.new" "$1/pid"
    n=0
    while [ -z "$end" ] && [ ! -e "$1/go" ] && [ $n -lt 200 ]; do sleep 0.05; n=$((n+1)); done
    sleep 0.1
    eval "printf 'out:%s\n' \"\$$2\""
    exit "${end:-0}" ;;
esac
