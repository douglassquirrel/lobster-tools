#!/usr/bin/env python3
"""each: run one command over a list of items, one at a time. Run with --help."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from lobstertools.each import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
